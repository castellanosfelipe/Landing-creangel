# Dominio público usado en canonical, Open Graph, JSON-LD, sitemap y robots.
# Se aplica al construir la imagen; al cambiarlo reconstruir con --build.
SITE_URL=https://portal.creangel.com

# Puerto HTTP local; el proxy HTTPS del hosting puede conectar aquí.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
IMAGE_TAG=local
