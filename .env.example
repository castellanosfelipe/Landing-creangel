# Copy to .env. Secrets are files in ./secrets, never values committed to Git.
PUBLIC_SITE_URL=https://portal.creangel.com
SITE_DOMAIN=portal.creangel.com
ACME_EMAIL=soluciones@creangel.com
CONTENT_REPOSITORY=castellanosfelipe/Landing-creangel
CONTENT_BRANCH=main
# Comma-separated GitHub accounts. Each account also needs repository push access.
CMS_ALLOWED_USERS=castellanosfelipe
GITHUB_CLIENT_ID=
HTTP_PORT=80
HTTPS_PORT=443
# Publication runs on the server. Retries follow the first attempt.
PUBLISH_ON_STARTUP=false
PUBLISH_MAX_RETRIES=3
PUBLISH_RETRY_BASE_SECONDS=5
PUBLISH_RETRY_MAX_SECONDS=60
BUILD_TIMEOUT_SECONDS=1200
KEEP_RELEASES=5
